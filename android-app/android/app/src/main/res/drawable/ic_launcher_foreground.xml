        android:fillColor="#CCE9F6"
        android:pathData="M59,53 L57,61 L65,59 Z" />

    <!-- Pen tip point -->
    <path
        android:fillColor="#FFFFFF"
        android:pathData="M57,61 L56,64 L60,62 Z" />

</vector>
