        android:strokeColor="#0090D4"
        android:strokeWidth="2"
        android:strokeLineCap="round"
        android:pathData="M46,43 L62,43" />
    <path
        android:strokeColor="#0090D4"
        android:strokeWidth="2"
        android:strokeLineCap="round"
        android:pathData="M46,51 L62,51" />
    <path
