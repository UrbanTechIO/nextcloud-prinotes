        android:fillColor="#FFFFFF"
        android:pathData="
          M45,33
          L63,33
          C64.7,33 66,34.3 66,36
          L66,75
          C66,76.7 64.7,78 63,78
          L45,78
          C43.3,78 42,76.7 42,75
          L42,36
          C42,34.3 43.3,33 45,33
          Z" />

    <!-- Ruled lines (Nextcloud blue so they show against white) -->
