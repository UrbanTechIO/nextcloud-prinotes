<?xml version="1.0" encoding="utf-8"?>
<!--
  Allows connecting to your local Nextcloud over HTTP (for self-signed certs or local network).
  For production, remove the cleartext allowance and use HTTPS with a valid cert.
-->
<network-security-config>
    <base-config cleartextTrafficPermitted="true">
        <trust-anchors>
            <certificates src="system" />
            <certificates src="user" />
        </trust-anchors>
    </base-config>
</network-security-config>
